{
  "manifest_version": 3,
  "name": "Ilimitado Lov",
  "version": "4.3.2",
  "description": "Extensão Ilimitado Lov - Thin Client",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Abrir Ilimitado Lov",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "cookies",
    "tabs",
    "sidePanel",
    "activeTab",
    "scripting",
    "webRequest"
  ],
  "host_permissions": [
    "https://lovable.dev/*",
    "https://*.lovable.dev/*",
    "https://lovable-api.com/*",
    "https://api.lovable.dev/*",
    "https://wvelcefgihlxcnrmslul.supabase.co/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://lovable.dev/*",
        "https://*.lovable.dev/*"
      ],
      "js": ["hide-element.js"],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["remote-ui.js", "jszip.min.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; frame-src blob: https://wvelcefgihlxcnrmslul.supabase.co;"
  }
}
