{
  "manifest_version": 3,
  "name": "Ilimitado Lov - GitHub AI",
  "version": "8.1.0",
  "description": "Edita código via AI + GitHub (sem créditos Lovable)",
  "permissions": ["storage", "sidePanel", "scripting", "tabs", "webRequest"],
  "host_permissions": [
    "https://lovable.dev/*",
    "https://*.lovable.dev/*",
    "https://api.lovable.dev/*",
    "https://*.supabase.co/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": {},
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://lovable.dev/*", "https://*.lovable.dev/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}